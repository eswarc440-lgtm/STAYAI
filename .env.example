# StayAI Environment Configuration
# Copy to .env and populate secrets securely via your secret manager.
# NEVER put private secrets in VITE_* variables.

# Runtime Mode: "demo" (seeded data, non-bookable demo hotels) or "production"
APP_MODE="demo"
VITE_APP_MODE="demo"

# Server URL
APP_URL="http://localhost:3000"

# Gemini AI (Server-only — NEVER expose to client)
GEMINI_API_KEY=""

# Razorpay (Server-only secret & webhook secret; Key ID is public for Checkout)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
RAZORPAY_TEST_MODE="true"
FEATURE_RAZORPAY_UPI_QR="false"
FEATURE_MARKETPLACE_PAYOUTS="false"

# Optional Feature Flags (StayAI honestly reports "Not configured" when unset)
VITE_GOOGLE_MAPS_API_KEY=""
VITE_FEATURE_STORAGE_UPLOADS="false"
FEATURE_OTA_ADAPTER="false"
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
